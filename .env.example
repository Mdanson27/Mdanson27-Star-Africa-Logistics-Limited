# ==============================================================================
# Star Africa Logistics Operating System — Environment Example Template
# ==============================================================================

# ── Runtime & Security ────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=star-africa-logistics-os
ENVIRONMENT=development
DEBUG=True
APP_NAME="Star Africa Logistics Operating System"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=https://mdanson27.github.io,http://localhost:5173

# ── Database Infrastructure (PostgreSQL 16 / TimescaleDB) ──────────────────────
POSTGRES_USER=starafrica_user
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password
POSTGRES_DB=starafrica_db
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://starafrica_user:change_this_to_a_secure_postgres_password@postgres-db:5432/starafrica_db
DATABASE_URL_UNPOOLED=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Cache Engine (Valkey) ─────────────────────────────────────────────────────

VALKEY_URL=
VALKEY_HOST=valkey-cache
VALKEY_PORT=6379


# ── Neon Managed Better Auth ─────────────────────────────────────────────────
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
PLATFORM_ADMIN_EMAIL=

# ── Neon Object Storage ───────────────────────────────────────────────────────
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
DOCUMENTS_BUCKET=star-africa-logistics-documents

# ── Initial Platform Superuser (legacy local auth only) ───────────────────────
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_PASSWORD=change_this_to_a_strong_unique_admin_password
FIRST_SUPERUSER_NAME="STAR AFRICA LOGISTICS ADMIN"

# ── API Documentation & Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_ENABLED=true
DOCS_UI=scalar

# ── Sentry Observability (APM & Error Tracking) ────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Cloudflare Zero Trust Edge Tunnel ─────────────────────────────────────────

CLOUDFLARED_TUNNEL_TOKEN=


# ── SMTP Email Dispatch (Optional) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_ADDRESS=noreply@platform.internal
EMAILS_FROM_NAME="Star Africa Logistics Operating System"
